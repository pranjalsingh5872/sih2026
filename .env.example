# =============================================================================
# SIH26069 — National Weather Big Data Analytics Platform
# Copy to `.env` and edit. Every value here has a working default in
# app/core/config.py; this file exists to show you what is tunable.
# =============================================================================

# ------------------------------------------------------------------- app ----
APP_ENV=local                      # local | dev | staging | prod
LOG_LEVEL=INFO
LOG_JSON=true                      # false gives human-readable logs locally
API_V1_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ----------------------------------------------------------------- kafka ----
# Set KAFKA_ENABLED=false to run the whole pipeline on the in-process bus with
# no broker at all. Useful for tests, and a genuine fallback if Kafka dies
# mid-demo.
KAFKA_ENABLED=true
KAFKA_BOOTSTRAP_SERVERS=kafka:29092
KAFKA_PRODUCER_ACKS=all
KAFKA_PRODUCER_COMPRESSION=gzip
KAFKA_CONSUMER_MAX_POLL_RECORDS=200

# -------------------------------------------------------------- postgres ----
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=weatherdb
POSTGRES_USER=weather
POSTGRES_PASSWORD=weather_dev_pw   # MUST be changed outside local/dev

# ----------------------------------------------------------------- redis ----
REDIS_ENABLED=true
REDIS_URL=redis://redis:6379/0
IDEMPOTENCY_TTL_S=900              # window in which a resubmitted report is one report

# -------------------------------------------------------------- security ----
# Comma-separated. The app refuses to boot with these defaults when
# APP_ENV is staging or prod.
INGEST_API_KEYS=dev-citizen-key
ADMIN_API_KEYS=dev-admin-key
RATE_LIMIT_PER_MINUTE=60
MAX_UPLOAD_BYTES=8388608           # 8 MB
ALLOWED_MEDIA_TYPES=image/jpeg,image/png,image/webp
MEDIA_ROOT=/data/media

# ------------------------------------------------------------- geocoding ----
# The offline gazetteer (137 Indian places, multilingual aliases) is always on.
# The remote Nominatim step is opt-in: it adds a network dependency and a
# 1 req/s ceiling, which is the wrong trade during a traffic spike.
GEOCODER_REMOTE_ENABLED=false
GAZETTEER_MIN_SIMILARITY=0.82

# ------------------------------------------------------------- providers ----
# Mock mode generates realistic payloads in the provider's true response shape,
# so the normalizers are genuinely exercised rather than bypassed. IMD has no
# stable public JSON API, so IMD_MOCK_MODE=true is the normal setting.
IMD_MOCK_MODE=true
IMD_POLL_INTERVAL_S=180

OPENWEATHER_MOCK_MODE=true
OPENWEATHER_API_KEY=
OPENWEATHER_POLL_INTERVAL_S=300

# ------------------------------------------------- social feed simulator ----
# Pathology rates. These are the conditions Phase 2 has to survive, so they
# default high enough to be a real test rather than a demo-friendly trickle.
SOCIAL_SIM_RATE_PER_MIN=90
SOCIAL_SIM_DUPLICATE_RATIO=0.22    # reposts, mutated to defeat hash dedup
SOCIAL_SIM_MISSING_GEO_RATIO=0.35  # posts with no coordinates at all
SOCIAL_SIM_FAKE_RATIO=0.12         # labelled misinformation, for Phase 2 eval
SOCIAL_SIM_SEED=                   # set an integer for reproducible runs
